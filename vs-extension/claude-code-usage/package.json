{
  "name": "claude-token-statusbar",
  "displayName": "Claude Code Token Meter",
  "description": "Shows Claude Code session usage, weekly limits, and token counts in the VS Code status bar — updated after each response.",
  "version": "0.2.11",
  "publisher": "somshrestha",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/som3669/Claude-Code-Token-Meter"
  },
  "bugs": {
    "url": "https://github.com/som3669/Claude-Code-Token-Meter/issues"
  },
  "homepage": "https://github.com/som3669/Claude-Code-Token-Meter#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "ai",
    "tokens",
    "usage",
    "status bar",
    "claude code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-token-monitor.refresh",
        "title": "Claude Token Monitor: Refresh"
      },
      {
        "command": "claude-token-monitor.openManual",
        "title": "Claude Code Token Meter: Open Manual"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0"
  }
}
