{
  "name": "aigitpilot",
  "displayName": "AI Git Pilot",
  "description": "AI-powered commit messages using free models — Ollama, Groq, Gemini. No paid API required.",
  "version": "0.0.4",
  "publisher": "somshrestha",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/som3669/aigitpilot"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "keywords": ["git", "commit", "ai", "ollama", "groq", "gemini", "commit message", "conventional commits"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aigitpilot.generate",
        "title": "AI Git Pilot: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "aigitpilot.setup",
        "title": "AI Git Pilot: Setup / Change Provider"
      },
      {
        "command": "aigitpilot.installHook",
        "title": "AI Git Pilot: Install Global Git Hook"
      },
      {
        "command": "aigitpilot.openManual",
        "title": "AI Git Pilot: Open Manual"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aigitpilot.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "AI Git Pilot",
      "properties": {
        "aigitpilot.provider": {
          "type": "string",
          "enum": ["ollama", "groq", "gemini", "openrouter"],
          "default": "ollama",
          "description": "AI provider to use for generating commit messages."
        },
        "aigitpilot.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model to use. Recommended: qwen2.5-coder:7b"
        },
        "aigitpilot.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL."
        },
        "aigitpilot.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq API key (free at console.groq.com)."
        },
        "aigitpilot.groqModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Groq model to use."
        },
        "aigitpilot.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key (free at aistudio.google.com)."
        },
        "aigitpilot.openrouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key (free models available at openrouter.ai)."
        },
        "aigitpilot.style": {
          "type": "string",
          "enum": ["conventional", "short", "detailed"],
          "default": "conventional",
          "description": "Commit message style."
        },
        "aigitpilot.language": {
          "type": "string",
          "default": "english",
          "description": "Language for generated commit messages."
        },
        "aigitpilot.customInstructions": {
          "type": "string",
          "default": "",
          "description": "Extra instructions for the AI. E.g. 'Always include ticket number from branch name'."
        },
        "aigitpilot.maxDiffSize": {
          "type": "number",
          "default": 8000,
          "description": "Max diff characters to send to AI. Larger diffs are summarized."
        },
        "aigitpilot.excludeFiles": {
          "type": "array",
          "default": ["package-lock.json", "yarn.lock", "composer.lock", "*.min.js", "*.min.css"],
          "description": "Files to exclude from the diff before sending to AI."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0"
  }
}
