{
  "manifest_version": 3,
  "name": "Hookrate — Research & Analytics for Creators",
  "short_name": "Hookrate",
  "version": "0.1.0",
  "description": "Channel analytics, outlier scoring, monetization checks, revenue estimates, transcripts and a swipe file — shown directly on the pages you already browse.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://suggestqueries-clients6.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hookrate",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "src/content/lib/relay.js",
        "src/content/lib/util.js",
        "src/content/lib/bus.js",
        "src/content/lib/ui.js",
        "src/content/features/channel.js",
        "src/content/features/watch.js",
        "src/content/features/shorts.js",
        "src/content/features/home.js",
        "src/content/features/search.js",
        "src/content/router.js"
      ],
      "css": [
        "src/ui/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "src/content/lib/util.js",
        "src/content/lib/bus.js",
        "src/content/lib/ui.js",
        "src/content/features/studio.js"
      ],
      "css": [
        "src/ui/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "src/ui/*",
        "src/swipe/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ]
    }
  ]
}
