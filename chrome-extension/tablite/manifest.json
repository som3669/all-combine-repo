{
  "manifest_version": 3,
  "name": "TabLite — Smart Tab Memory Optimizer",
  "version": "1.0.0",
  "description": "Automatically suspends inactive tabs to free up RAM, with a popup dashboard showing your memory savings.",
  "permissions": ["tabs", "storage", "alarms", "system.memory"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabLite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
